# Dev-server defaults: boot against the MSW-stubbed HAL endpoint with
# dev-token auth (no real backend or OIDC needed). To develop against a
# real ContentGrid backend, override these in .env.development.local:
# set VITE_USE_MOCK_API=false, drop VITE_DEV_TOKEN, and point
# VITE_API_BASE_URL + VITE_OIDC_AUTHORITY + VITE_OIDC_CLIENT_ID at it.
VITE_USE_MOCK_API=true
VITE_DEV_TOKEN=dev-token
VITE_API_BASE_URL=http://localhost:5174
# PDF rendition service URI template (spec 002-pdf-viewer). Points at the mocked, same-origin
# endpoint src/mocks/rendition-handlers.ts intercepts (a real deployment's Liaison config.js
# would deliver the actual platform rendition URL instead — see that feature's CLAUDE.md).
# Switch the mocked outcome at runtime without restarting the dev server:
#   localStorage.setItem("contentgrid-navigator:dev-rendition-mode", "never"); location.reload();
# valid modes: ready | invalid-conversion | never | error. Unset entirely disables renditions
# (non-PDF content attributes show "Preview not available").
VITE_RENDITION_URI=http://localhost:5174/__mock__/renditions/pdf{?url}