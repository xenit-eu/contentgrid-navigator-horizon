# Dev-server defaults: boot against the MSW-stubbed HAL endpoint with
# dev-token auth (no real backend or OIDC needed). To develop against a
# real ContentGrid backend, override these in .env.development.local:
# set VITE_USE_MOCK_API=false, drop VITE_DEV_TOKEN, and point
# VITE_API_BASE_URL + VITE_OIDC_AUTHORITY + VITE_OIDC_CLIENT_ID at it.
VITE_USE_MOCK_API=false