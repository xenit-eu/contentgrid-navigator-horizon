{
  "name": "contentgrid-navigator-horizon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "shadcn": "shadcn",
    "registry:build": "pnpm --filter @contentgrid/ui registry:build",
    "dev:navigator": "pnpm --filter navigator dev",
    "dev:navigator-experimental": "pnpm --filter navigator-experimental dev",
    "storybook": "pnpm --filter storybook dev",
    "build": "pnpm -r run --if-present build",
    "typecheck": "pnpm -r run --if-present typecheck",
    "prelint": "pnpm --filter @contentgrid/eslint-config build",
    "lint": "pnpm -r run --if-present lint",
    "clean": "pnpm -r run --if-present clean",
    "pretest": "pnpm --filter @contentgrid/eslint-config build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm --filter @contentgrid/eslint-config build && vitest run --coverage",
    "test:e2e": "pnpm -r run --if-present test:e2e",
    "test:storybook": "pnpm --filter storybook test:storybook",
    "test:visual": "pnpm -r run --if-present test:visual",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:a11y": "pnpm --filter storybook test:a11y",
    "test:visual:update": "pnpm -r run --if-present test:visual:update"
  },
  "devDependencies": {
    "@contentgrid/eslint-config": "workspace:*",
    "shadcn": "4.8.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "^10.0.0",
    "husky": "^9.0.0",
    "jsdom": "29.1.1",
    "lint-staged": "^17.0.0",
    "@types/react": "^19.1.5",
    "msw": "2.14.6",
    "prettier": "^3.0.0",
    "vitest": "4.1.7"
  },
  "lint-staged": {
    "!(packages/eslint-config/rules/__fixtures__/**).{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md}": "prettier --write"
  }
}
