{
  "name": "@contentgrid/ui",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./styles/preset.css": "./src/styles/preset.css",
    "./tokens": "./tokens/index.css",
    "./tokens/index.css": "./tokens/index.css",
    "./tailwind-preset": "./tailwind-preset.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "registry:build": "shadcn build registry.json --output r",
    "test:visual": "pnpm --filter storybook run visual",
    "test:visual:update": "pnpm --filter storybook run visual:update"
  },
  "dependencies": {
    "@fontsource/open-sans": "5.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "@phosphor-icons/react": "2.1.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^10.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@contentgrid/eslint-config": "workspace:*",
    "@contentgrid/navigator-data": "workspace:*",
    "@contentgrid/tsconfig": "workspace:*",
    "@storybook/react": "^10.0.0",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "eslint": "^10.0.0",
    "storybook": "10.4.2",
    "typescript": "^6.0.0"
  }
}
